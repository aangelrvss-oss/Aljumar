{
  "name": "aljumar-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nueva web de Aljumar Inmuebles: sitio estático Astro alimentado por el CRM Inmovilla",
  "scripts": {
    "sync": "node scripts/sync-inventory.ts",
    "predev": "node scripts/gen-redirects.ts",
    "dev": "astro dev",
    "prebuild": "node scripts/gen-redirects.ts && node scripts/guard-build.ts",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:php": "node scripts/test-form.ts",
    "check": "node scripts/check-site.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run check && npm run test:php && npm run test:e2e",
    "import:blog": "node scripts/import-wp-posts.ts",
    "media:fetch": "node scripts/fetch-legacy-media.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "astro": "7.3.8",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "playwright-core": "^1.56.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
