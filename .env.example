# Copia este archivo como .env (no se versiona) o define las variables en el
# entorno de CI. Ningún valor real debe escribirse en el repositorio.

# --- Compilación -----------------------------------------------------------
# URL pública del sitio (canonical, sitemap, Open Graph).
SITE_URL=https://aljumar.es
# "production" activa las comprobaciones de publicación (scripts/guard-build.ts):
# el inventario debe proceder de Inmovilla y no de la instantánea de muestra.
SITE_ENV=preview
# 1 = toda la web con noindex (entornos de prueba).
STAGING=1

# --- Inventario (Inmovilla) -------------------------------------------------
# URL privada del XML diario de Inmovilla para la web (la facilita Inmovilla:
# soporte@inmovilla.com). Formato documentado en docs/architecture.
INMOVILLA_XML_URL=
# Número de agencia en Inmovilla (las fotos usan fotos15.apinmo.com/4397/...).
INMOVILLA_AGENCY=4397

# --- Formularios (PHP en el servidor) --------------------------------------
# Se configuran en public/api/config.php en el servidor (ver config.example.php),
# nunca aquí.
