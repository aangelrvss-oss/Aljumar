---
/**
 * Tarjeta de inmueble. El HTML lo genera src/lib/inventory/card.ts, el mismo
 * que usa el buscador en el navegador; los estilos están en styles/cards.css.
 */
import type { Operation, Property } from '../lib/inventory/types';
import { cardModel, renderCard } from '../lib/inventory/card';

interface Props {
  property: Property;
  /** Operación con la que se muestra (en /alquilar/ se ve el precio de alquiler). */
  operation?: Operation;
  /** La primera fila de tarjetas carga su imagen con prioridad. */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
  showOperation?: boolean;
}
const { property, operation, eager = false, headingLevel = 'h3', showOperation = false } = Astro.props;
---

<Fragment set:html={renderCard(cardModel(property, operation), { eager, heading: headingLevel, showOperation })} />
