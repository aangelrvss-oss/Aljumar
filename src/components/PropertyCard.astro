---
import Icon from './Icon.astro';
import type { Operation, Property } from '../lib/inventory/types';
import { formatArea, formatPrice, headline, mainArea, OPERATION_LABEL, placeLabel, priceFor } from '../lib/inventory/format';

interface Props {
  property: Property;
  /** Operación con la que se muestra (en /alquilar/ se ve el precio de alquiler). */
  operation?: Operation;
  /** La primera fila de tarjetas carga su imagen con prioridad. */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { property: p, operation = p.operations[0] ?? 'venta', eager = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const price = priceFor(p, operation);
const area = mainArea(p);
const photo = p.photos[0];
const href = `/inmueble/${p.slug}/`;
const extra = p.features.filter((f) => /terraza|garaje|piscina|ascensor|trastero|jard/i.test(f)).slice(0, 2);
---

<article class="card" data-property-card data-id={p.id}>
  <div class="card__media">
    {
      photo ? (
        <img
          src={photo.url}
          alt={photo.alt}
          width="640"
          height="480"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
          data-fallback
        />
      ) : null
    }
    <div class="card__placeholder" aria-hidden="true">
      <Icon name="camera" size={28} />
      <span>Fotografías disponibles en la oficina</span>
    </div>
    <div class="card__badges">
      <span class="badge badge--dark">{OPERATION_LABEL[operation]}</span>
      {p.status !== 'disponible' && <span class="badge badge--accent">{p.status === 'reservado' ? 'Reservado' : p.status}</span>}
    </div>
    {p.photos.length > 1 && (
      <span class="card__count">
        <Icon name="camera" size={14} /> {p.photos.length}
        <span class="visually-hidden"> fotografías</span>
      </span>
    )}
  </div>

  <div class="card__body">
    <p class="card__price">{formatPrice(price, operation)}</p>
    <Heading class="card__title">
      <a href={href}>{headline(p)}</a>
    </Heading>
    <p class="card__place">
      <Icon name="pin" size={16} />
      {placeLabel(p)}
    </p>
    {p.title && <p class="card__subtitle">{p.title}</p>}

    <ul class="card__specs" aria-label="Características principales">
      {
        p.bedrooms !== null && (
          <li>
            <Icon name="bed" size={18} />
            {p.bedrooms} {p.bedrooms === 1 ? 'dormitorio' : 'dormitorios'}
          </li>
        )
      }
      {
        p.bathrooms !== null && (
          <li>
            <Icon name="bath" size={18} />
            {p.bathrooms} {p.bathrooms === 1 ? 'baño' : 'baños'}
          </li>
        )
      }
      {
        area && (
          <li>
            <Icon name="area" size={18} />
            {formatArea(area.value)}
            <span class="visually-hidden"> {area.label}</span>
          </li>
        )
      }
    </ul>
    {
      extra.length > 0 && (
        <p class="card__extra">
          {extra.map((f) => (
            <span>{f}</span>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--navy-200);
    transform: translateY(-2px);
  }
  .card:focus-within {
    outline: 3px solid var(--navy-700);
    outline-offset: 2px;
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--navy-100), var(--navy-50));
    overflow: hidden;
  }
  .card__media img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .card:hover .card__media img {
    transform: scale(1.035);
  }
  .card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-2);
    padding: var(--s-4);
    color: var(--navy-500);
    font-size: var(--fs-xs);
    text-align: center;
  }
  .card__badges {
    position: absolute;
    z-index: 2;
    top: var(--s-3);
    left: var(--s-3);
    display: flex;
    gap: var(--s-2);
  }
  .card__count {
    position: absolute;
    z-index: 2;
    right: var(--s-3);
    bottom: var(--s-3);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: rgb(15 37 55 / 0.78);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--s-4) var(--s-5) var(--s-5);
  }
  .card__price {
    order: -1;
    margin: 0 0 var(--s-1);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--navy-900);
    letter-spacing: -0.01em;
  }
  .card__title {
    margin: 0 0 var(--s-1);
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: var(--lh-snug);
  }
  .card__title a {
    color: var(--navy-900);
    text-decoration: none;
  }
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .card__title a:focus-visible {
    outline: none;
  }
  .card__place {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin: 0 0 var(--s-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .card__subtitle {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 var(--s-3);
    font-size: var(--fs-sm);
    color: var(--ink);
  }
  .card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: auto 0 0;
    padding: var(--s-3) 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--navy-900);
  }
  .card__specs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .card__specs :global(svg) {
    color: var(--navy-500);
  }
  .card__extra {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
    font-size: var(--fs-xs);
  }
  .card__extra span {
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: var(--lime-100);
    color: var(--navy-900);
    font-weight: 600;
  }
</style>
