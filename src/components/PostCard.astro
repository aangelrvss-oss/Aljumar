---
/**
 * Artículo en un listado: tipográfico, sin cajas. Si el artículo tiene una
 * imagen migrada en public/, se muestra; si no, no se inventa ninguna.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import type { CollectionEntry } from 'astro:content';
import { topics } from '../data/topics';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { title, description, pubDate, image, imageAlt, topic } = post.data;
const hasImage = image ? existsSync(resolve(process.cwd(), 'public', '.' + image)) : false;
const date = pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="post">
  {hasImage && <img class="post__img" src={image} alt={imageAlt ?? ''} width="640" height="400" loading="lazy" decoding="async" />}
  <p class="post__meta">
    {topics[topic].label} · <time datetime={pubDate.toISOString().slice(0, 10)}>{date}</time>
  </p>
  <Heading class="post__title"><a href={`/${post.id}/`}>{title}</a></Heading>
  <p class="post__excerpt">{description}</p>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
  }
  .post__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: var(--s-4);
  }
  .post__meta {
    margin: 0 0 var(--s-2);
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .post__title {
    margin: 0 0 var(--s-3);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 380;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.012em;
    line-height: 1.2;
  }
  .post__title a {
    color: var(--navy-900);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 500ms var(--ease-out);
  }
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post:hover .post__title a,
  .post__title a:focus-visible {
    background-size: 100% 1px;
  }
  .post:focus-within {
    outline: 2px solid var(--navy-700);
    outline-offset: 6px;
  }
  .post__title a:focus-visible {
    outline: none;
  }
  .post__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
</style>
