---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import type { CollectionEntry } from 'astro:content';
import { topics } from '../data/topics';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { title, description, pubDate, image, imageAlt, topic } = post.data;
const hasImage = image ? existsSync(resolve(process.cwd(), 'public', '.' + image)) : false;
const date = pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="post">
  <div class="post__media">
    {hasImage ? <img src={image} alt={imageAlt ?? ''} width="640" height="400" loading="lazy" decoding="async" /> : null}
    <span class="post__topic">{topics[topic].label}</span>
  </div>
  <div class="post__body">
    <Heading class="post__title"><a href={`/${post.id}/`}>{title}</a></Heading>
    <p class="post__excerpt">{description}</p>
    <p class="post__date"><time datetime={pubDate.toISOString().slice(0, 10)}>{date}</time></p>
  </div>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    transition: box-shadow var(--dur) var(--ease);
  }
  .post:hover {
    box-shadow: var(--shadow-md);
  }
  .post:focus-within {
    outline: 3px solid var(--navy-700);
    outline-offset: 2px;
  }
  .post__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 85% 20%, rgb(191 214 0 / 0.35) 0 18%, transparent 19%),
      linear-gradient(135deg, var(--navy-700), var(--navy-900));
  }
  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post__topic {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--lime-500);
    color: var(--navy-950);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .post__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--s-4) var(--s-5) var(--s-5);
  }
  .post__title {
    margin-bottom: var(--s-2);
    font-size: var(--fs-md);
  }
  .post__title a {
    color: var(--navy-900);
    text-decoration: none;
  }
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post__title a:focus-visible {
    outline: none;
  }
  .post__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .post__date {
    margin: auto 0 0;
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
</style>
