---
/**
 * Escala del certificado de eficiencia energética. La letra se indica con
 * texto además del color (no se depende solo del color).
 */
import type { Property } from '../lib/inventory/types';

interface Props {
  energy: Property['energy'];
  emissions: Property['emissions'];
}
const { energy, emissions } = Astro.props;
const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G'] as const;
const colors: Record<string, string> = {
  A: '#0b7a3e',
  B: '#3a9a3c',
  C: '#8cbc2e',
  D: '#e6c619',
  E: '#f0a524',
  F: '#e2621e',
  G: '#c8221e',
};
const statusText: Record<string, string> = {
  'en-tramite': 'Certificado energético en trámite.',
  exento: 'Inmueble exento de certificado energético.',
  pendiente: 'Certificado energético pendiente de aportar por la propiedad.',
};
---

{
  energy.letter ? (
    <div class="energy">
      <p class="energy__summary">
        Consumo <strong>{energy.letter}</strong>
        {energy.value && <span> · {energy.value} kWh/m² año</span>}
        {emissions.letter && (
          <>
            <span class="energy__sep" aria-hidden="true" />
            Emisiones <strong>{emissions.letter}</strong>
            {emissions.value && <span> · {emissions.value} kg CO₂/m² año</span>}
          </>
        )}
      </p>
      <ol class="energy__scale" aria-hidden="true">
        {letters.map((l) => (
          <li class:list={['energy__step', { 'is-current': l === energy.letter }]} style={`--c:${colors[l]}`}>
            {l}
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <p class="energy__none">{statusText[energy.status ?? 'pendiente'] ?? 'Consúltanos la calificación energética.'}</p>
  )
}

<style>
  .energy {
    display: grid;
    gap: var(--s-3);
  }
  .energy__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4em;
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .energy__summary strong {
    color: var(--navy-900);
    font-size: var(--fs-md);
  }
  .energy__sep {
    width: 1px;
    height: 1em;
    margin-inline: var(--s-3);
    background: var(--line-strong);
    align-self: center;
  }
  .energy__scale {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 44px));
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .energy__step {
    display: grid;
    place-items: center;
    height: 26px;
    background: var(--c);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 700;
    opacity: 0.28;
  }
  .energy__step.is-current {
    height: 34px;
    margin-top: -4px;
    opacity: 1;
    box-shadow: 0 0 0 2px var(--white), 0 0 0 3px var(--navy-900);
  }
  .energy__none {
    margin: 0;
    color: var(--ink-2);
  }
</style>
