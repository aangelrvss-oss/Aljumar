---
/**
 * Escala del certificado de eficiencia energética. La letra se indica con
 * texto además del color (no se depende solo del color).
 */
import type { Property } from '../lib/inventory/types';

interface Props {
  energy: Property['energy'];
  emissions: Property['emissions'];
}
const { energy, emissions } = Astro.props;
const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G'] as const;
const colors: Record<string, string> = {
  A: '#0b7a3e',
  B: '#3a9a3c',
  C: '#8cbc2e',
  D: '#e6c619',
  E: '#f0a524',
  F: '#e2621e',
  G: '#c8221e',
};
const statusText: Record<string, string> = {
  'en-tramite': 'Certificado energético en trámite.',
  exento: 'Inmueble exento de certificado energético.',
  pendiente: 'Certificado energético pendiente de aportar por la propiedad.',
};
---

{
  energy.letter ? (
    <div class="energy">
      <p class="energy__summary">
        Consumo: <strong>{energy.letter}</strong>
        {energy.value && <span> ({energy.value} kWh/m² año)</span>}
        {emissions.letter && (
          <>
            {' '}
            · Emisiones: <strong>{emissions.letter}</strong>
            {emissions.value && <span> ({emissions.value} kg CO₂/m² año)</span>}
          </>
        )}
      </p>
      <ol class="energy__scale" aria-hidden="true">
        {letters.map((l, i) => (
          <li
            class:list={['energy__bar', { 'is-current': l === energy.letter }]}
            style={`--c:${colors[l]};--w:${40 + i * 9}%`}
          >
            <span>{l}</span>
            {l === energy.letter && <b>Este inmueble</b>}
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <p class="muted">{statusText[energy.status ?? 'pendiente'] ?? 'Consúltanos la calificación energética.'}</p>
  )
}

<style>
  .energy__summary {
    margin-bottom: var(--s-3);
  }
  .energy__scale {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 420px;
  }
  .energy__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .energy__bar span {
    display: flex;
    align-items: center;
    width: var(--w);
    height: 24px;
    padding-left: 10px;
    border-radius: 3px 12px 12px 3px;
    background: var(--c);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 800;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.35);
    opacity: 0.55;
  }
  .energy__bar.is-current span {
    opacity: 1;
    height: 30px;
    outline: 2px solid var(--navy-900);
    outline-offset: 2px;
  }
  .energy__bar b {
    font-size: var(--fs-xs);
    color: var(--navy-900);
  }
</style>
