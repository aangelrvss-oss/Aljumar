---
/**
 * Galería de la ficha.
 *
 * - Escenario: una pista horizontal con todas las fotos y scroll-snap. En
 *   móvil se desliza con el dedo de forma nativa; en escritorio se usan las
 *   flechas o las miniaturas. Sin JavaScript sigue siendo una pista que se
 *   puede desplazar.
 * - Visor a pantalla completa con <dialog> nativo (foco atrapado, Escape):
 *   fundido entre fotos, tira de miniaturas, flechas del teclado y gesto de
 *   deslizar.
 * - Si una foto no carga, queda el marcador con el símbolo de la marca.
 */
import Icon from './Icon.astro';
import type { Photo } from '../lib/inventory/types';

interface Props {
  photos: Photo[];
  title: string;
}
const { photos, title } = Astro.props;
const many = photos.length > 1;
---

{
  photos.length === 0 ? (
    <div class="gallery-empty">
      <p>Este inmueble todavía no tiene fotografías publicadas. Pídenos más información y te las enviamos.</p>
    </div>
  ) : (
    <div class="gallery" data-gallery>
      <div class="gallery__stage">
        <ul class="gallery__track" data-track aria-label={`Fotografías: ${title}`} tabindex="0">
          {photos.map((ph, i) => (
            <li class="gallery__slide" data-slide={i}>
              <img
                src={ph.url}
                alt={ph.alt}
                width="1200"
                height="800"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                data-fallback
              />
            </li>
          ))}
        </ul>
        {many && (
          <>
            <button type="button" class="gallery__nav gallery__nav--prev" data-step="-1" disabled>
              <Icon name="arrow-left" />
              <span class="visually-hidden">Foto anterior</span>
            </button>
            <button type="button" class="gallery__nav gallery__nav--next" data-step="1">
              <Icon name="arrow-right" />
              <span class="visually-hidden">Foto siguiente</span>
            </button>
          </>
        )}
        <p class="gallery__count" aria-hidden="true">
          <span data-current>1</span> / {photos.length}
        </p>
        <button type="button" class="gallery__all" data-open="0">
          <Icon name="expand" size={16} /> Ver las {photos.length} fotografías
        </button>
      </div>

      {many && (
        <ol class="gallery__thumbs" aria-label="Miniaturas">
          {photos.map((ph, i) => (
            <li>
              <button type="button" class="gallery__thumb" data-goto={i} aria-label={`Ver fotografía ${i + 1} de ${photos.length}`} aria-current={i === 0 ? 'true' : undefined}>
                <img src={ph.url} alt="" width="160" height="107" loading="lazy" decoding="async" data-fallback />
              </button>
            </li>
          ))}
        </ol>
      )}

      <dialog class="lightbox" aria-label={`Fotografías: ${title}`} data-lightbox>
        <div class="lightbox__bar">
          <p class="lightbox__count" aria-live="polite" data-counter>
            1 / {photos.length}
          </p>
          <button type="button" class="lightbox__btn" data-close>
            <Icon name="close" />
            <span class="visually-hidden">Cerrar</span>
          </button>
        </div>
        <figure class="lightbox__stage" data-stage-wrap>
          <img src="" alt="" class="is-current" data-layer />
          <img src="" alt="" aria-hidden="true" data-layer />
        </figure>
        {many && (
          <>
            <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-prev>
              <Icon name="arrow-left" />
              <span class="visually-hidden">Foto anterior</span>
            </button>
            <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-next>
              <Icon name="arrow-right" />
              <span class="visually-hidden">Foto siguiente</span>
            </button>
            <ol class="lightbox__thumbs" data-lb-thumbs>
              {photos.map((ph, i) => (
                <li>
                  <button type="button" data-lb-goto={i} aria-label={`Fotografía ${i + 1}`}>
                    <img src={ph.url} alt="" width="96" height="64" loading="lazy" decoding="async" />
                  </button>
                </li>
              ))}
            </ol>
          </>
        )}
        <script type="application/json" data-photos set:html={JSON.stringify(photos)} />
      </dialog>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const photos = JSON.parse(g.querySelector('[data-photos]')!.textContent || '[]') as { url: string; alt: string }[];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // ---------- Escenario con pista desplazable ----------
    const track = g.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const current = g.querySelector<HTMLElement>('[data-current]')!;
    const prev = g.querySelector<HTMLButtonElement>('[data-step="-1"]');
    const next = g.querySelector<HTMLButtonElement>('[data-step="1"]');
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    let active = 0;

    const goTo = (i: number) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
      if (target) track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: reduce.matches ? 'auto' : 'smooth' });
    };
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      current.textContent = String(i + 1);
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
      thumbs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      thumbs[i]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => setActive(Math.round(track.scrollLeft / Math.max(1, track.clientWidth))));
      },
      { passive: true },
    );
    prev?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => goTo(Number(t.dataset.goto))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') (e.preventDefault(), goTo(active + 1));
      if (e.key === 'ArrowLeft') (e.preventDefault(), goTo(active - 1));
    });
    // Un toque/clic en la foto abre el visor en esa foto.
    slides.forEach((s, i) =>
      s.addEventListener('click', () => {
        opener = g.querySelector<HTMLElement>('[data-open]');
        openAt(i);
      }),
    );

    // ---------- Visor ----------
    const dialog = g.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const layers = [...dialog.querySelectorAll<HTMLImageElement>('[data-layer]')];
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    const lbThumbs = [...dialog.querySelectorAll<HTMLButtonElement>('[data-lb-goto]')];
    let index = 0;
    let front = 0;
    let opener: HTMLElement | null = null;

    function show(i: number, instant = false) {
      index = (i + photos.length) % photos.length;
      const p = photos[index]!;
      const incoming = layers[1 - front]!;
      const outgoing = layers[front]!;
      if (instant || reduce.matches) {
        outgoing.src = p.url;
        outgoing.alt = p.alt;
      } else {
        incoming.src = p.url;
        incoming.alt = p.alt;
        incoming.removeAttribute('aria-hidden');
        outgoing.setAttribute('aria-hidden', 'true');
        incoming.classList.add('is-current');
        outgoing.classList.remove('is-current');
        front = 1 - front;
      }
      counter.textContent = `${index + 1} / ${photos.length}`;
      lbThumbs.forEach((t, k) => (k === index ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      lbThumbs[index]?.scrollIntoView({ block: 'nearest', inline: 'center' });
      // Precarga la siguiente para que el paso sea inmediato.
      const n = photos[(index + 1) % photos.length];
      if (n) new Image().src = n.url;
    }
    function openAt(i: number) {
      show(i, true);
      dialog.showModal();
    }

    g.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        openAt(active || Number(b.dataset.open) || 0);
      }),
    );
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    lbThumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.lbGoto))));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      goTo(index);
      opener?.focus();
    });
    const stage = dialog.querySelector<HTMLElement>('[data-stage-wrap]')!;
    let startX = 0;
    stage.addEventListener('touchstart', (e) => (startX = e.touches[0]?.clientX ?? 0), { passive: true });
    stage.addEventListener(
      'touchend',
      (e) => {
        const dx = (e.changedTouches[0]?.clientX ?? 0) - startX;
        if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  });
</script>

<style>
  .gallery-empty {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-4);
    aspect-ratio: 16 / 9;
    padding: var(--s-6);
    background: var(--navy-800);
    color: var(--navy-200);
    text-align: center;
  }
  .gallery-empty::before {
    content: '';
    width: 56px;
    height: 68px;
    background: url('/brand/logo-simbolo.png') center / contain no-repeat;
    opacity: 0.6;
  }
  .gallery-empty p {
    max-width: 40ch;
    margin: 0;
  }

  .gallery__stage {
    position: relative;
    background: var(--navy-800);
  }
  .gallery__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gallery__track::-webkit-scrollbar {
    display: none;
  }
  .gallery__track:focus-visible {
    outline: 2px solid var(--lime-500);
    outline-offset: -4px;
  }
  .gallery__slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 3 / 2;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    cursor: zoom-in;
    background: url('/brand/logo-simbolo.png') center / 52px auto no-repeat;
  }
  .gallery__slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__slide img[data-broken],
  .gallery__thumb img[data-broken] {
    visibility: hidden;
  }
  .gallery__nav {
    position: absolute;
    top: 50%;
    display: none;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border: 0;
    background: rgb(255 255 255 / 0.92);
    color: var(--navy-900);
    cursor: pointer;
    transition:
      opacity var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .gallery__nav:hover {
    background: var(--white);
  }
  .gallery__nav:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .gallery__nav--prev {
    left: var(--s-4);
  }
  .gallery__nav--next {
    right: var(--s-4);
  }
  .gallery__count {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    margin: 0;
    padding: 0.2rem 0.6rem;
    background: rgb(15 37 55 / 0.75);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .gallery__all {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    padding: 0 var(--s-4);
    border: 0;
    background: var(--white);
    color: var(--navy-900);
    font: inherit;
    font-size: var(--fs-xs);
    font-weight: 650;
    cursor: pointer;
  }
  .gallery__all:hover {
    background: var(--lime-500);
  }
  .gallery__thumbs {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery__nav {
      display: grid;
    }
  }
  @media (min-width: 900px) {
    .gallery__slide {
      aspect-ratio: 16 / 9;
    }
    .gallery__thumbs {
      display: flex;
      gap: var(--s-2);
      margin: var(--s-2) 0 0;
      padding: 0 0 var(--s-1);
      list-style: none;
      overflow-x: auto;
      scrollbar-width: thin;
    }
    .gallery__thumb {
      position: relative;
      display: block;
      width: 112px;
      aspect-ratio: 3 / 2;
      padding: 0;
      border: 0;
      background: var(--navy-800);
      cursor: pointer;
      opacity: 0.55;
      transition: opacity var(--dur) var(--ease);
    }
    .gallery__thumb::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -5px;
      height: 2px;
      background: var(--lime-500);
      transform: scaleX(0);
      transition: transform 360ms var(--ease-out);
    }
    .gallery__thumb:hover,
    .gallery__thumb[aria-current='true'] {
      opacity: 1;
    }
    .gallery__thumb[aria-current='true']::after {
      transform: scaleX(1);
    }
    .gallery__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .gallery__thumbs li {
      flex: none;
      padding-bottom: 6px;
    }
  }

  /* ---------- Visor ---------- */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 22 33 / 0.97);
    color: var(--white);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lb-in 320ms var(--ease-out);
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox::backdrop {
    background: rgb(10 22 33 / 0.9);
  }
  .lightbox__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--s-3) var(--s-4);
  }
  .lightbox__count {
    margin: 0;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .lightbox__stage {
    position: relative;
    margin: 0;
    min-height: 0;
  }
  .lightbox__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 420ms var(--ease-out);
  }
  .lightbox__stage img.is-current {
    opacity: 1;
  }
  .lightbox__btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
    cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.18);
  }
  .lightbox__nav {
    position: absolute;
    top: 50%;
    margin-top: -24px;
  }
  .lightbox__nav--prev {
    left: var(--s-3);
  }
  .lightbox__nav--next {
    right: var(--s-3);
  }
  .lightbox__thumbs {
    display: flex;
    gap: var(--s-2);
    margin: 0;
    padding: var(--s-3) var(--s-4) var(--s-4);
    list-style: none;
    overflow-x: auto;
  }
  .lightbox__thumbs li {
    flex: none;
  }
  .lightbox__thumbs button {
    display: block;
    width: 72px;
    aspect-ratio: 3 / 2;
    padding: 0;
    border: 0;
    background: var(--navy-800);
    opacity: 0.45;
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }
  .lightbox__thumbs button[aria-current='true'] {
    opacity: 1;
    outline: 2px solid var(--lime-500);
    outline-offset: 2px;
  }
  .lightbox__thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lightbox :focus-visible {
    outline-color: var(--lime-500);
  }
</style>
