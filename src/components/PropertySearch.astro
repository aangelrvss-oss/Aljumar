---
/**
 * Listado con filtros.
 *
 * Sin JavaScript (y para los buscadores): páginas estáticas de 24 inmuebles
 * (/comprar/, /comprar/pagina/2/…) con enlaces de paginación normales.
 *
 * Con JavaScript, al filtrar u ordenar: el navegador descarga el índice
 * /datos/inmuebles-<operación>.json (una sola vez y solo cuando hace falta),
 * filtra con la misma lógica que las pruebas (src/lib/inventory/filters.ts),
 * guarda los criterios en la URL y pinta las tarjetas de 24 en 24 con el
 * mismo HTML que el servidor (src/lib/inventory/card.ts). «Mostrar más»
 * añade de verdad las siguientes tarjetas al DOM: no hay tarjetas ocultas.
 */
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import { byOperation, filterOptions } from '../lib/inventory';
import { SORTS } from '../lib/inventory/filters';
import { TYPE_GROUP_LABEL } from '../lib/inventory/format';
import { cardModel, renderCard } from '../lib/inventory/card';
import type { Operation } from '../lib/inventory/types';
import { LISTING_BASE, PAGE_SIZE } from '../lib/inventory/listing';

interface Props {
  operation: Operation;
  page?: number;
}
const { operation, page = 1 } = Astro.props;
const all = byOperation(operation);
const lastPage = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const slice = all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const opts = filterOptions(operation);
const base = LISTING_BASE[operation];
const dataUrl = `/datos/inmuebles-${operation}.json`;
const contactHref = `/contacto/?motivo=${operation === 'alquiler' ? 'alquilar' : 'comprar'}#formulario`;

const priceSteps =
  operation === 'alquiler'
    ? [500, 700, 900, 1100, 1300, 1500, 1800, 2200, 2600, 3000, 4000]
    : [60000, 100000, 150000, 200000, 250000, 300000, 350000, 400000, 500000, 600000, 750000, 1000000, 1500000, 2000000];
const fmt = (n: number) => new Intl.NumberFormat('es-ES').format(n) + (operation === 'alquiler' ? ' €/mes' : ' €');
const features = [...opts.features].sort((a, b) => b.count - a.count).slice(0, 10);
const plural = (n: number) => (n === 1 ? 'inmueble' : 'inmuebles');
---

<div
  class="search"
  data-search
  data-operation={operation}
  data-src={dataUrl}
  data-total={all.length}
  data-page-size={PAGE_SIZE}
  data-base={base}
>
  {
    all.length > 0 && (
      <div class="search__bar">
        <button type="button" class="btn btn--ghost search__open" aria-controls="filtros" aria-expanded="false" data-filters-open>
          <Icon name="sliders" size={18} /> Filtros <span class="search__badge" data-active-count hidden />
        </button>

        <div class="filters" id="filtros" aria-labelledby="filtros-titulo" data-filters>
          <div class="filters__head">
            <h2 id="filtros-titulo" class="filters__title">Filtrar inmuebles</h2>
            <button type="button" class="filters__close" data-filters-close>
              <Icon name="close" />
              <span class="visually-hidden">Cerrar filtros</span>
            </button>
          </div>

          <form id="form-filtros" class="filters__form" method="get" action={base} data-form>
            <div class="filters__main">
              {opts.cities.length > 1 && (
                <div class="ff">
                  <label for="f-ciudad">Localidad</label>
                  <select id="f-ciudad" name="ciudad" class="ff__select">
                    <option value="">Todas</option>
                    {opts.cities.map((c) => (
                      <option value={c.value}>
                        {c.label} ({c.count})
                      </option>
                    ))}
                  </select>
                </div>
              )}
              {opts.typeGroups.length > 1 && (
                <div class="ff">
                  <label for="f-tipo">Tipo</label>
                  <select id="f-tipo" name="tipo" class="ff__select">
                    <option value="">Todos</option>
                    {opts.typeGroups.map((t) => (
                      <option value={t.value}>
                        {TYPE_GROUP_LABEL[t.value as keyof typeof TYPE_GROUP_LABEL]} ({t.count})
                      </option>
                    ))}
                  </select>
                </div>
              )}
              <fieldset class="ff ff--pair">
                <legend>Precio</legend>
                <label class="visually-hidden" for="f-pmin">
                  Precio mínimo
                </label>
                <select id="f-pmin" name="precio_min" class="ff__select">
                  <option value="">Mín.</option>
                  {priceSteps.map((s) => (
                    <option value={s}>{fmt(s)}</option>
                  ))}
                </select>
                <label class="visually-hidden" for="f-pmax">
                  Precio máximo
                </label>
                <select id="f-pmax" name="precio_max" class="ff__select">
                  <option value="">Máx.</option>
                  {priceSteps.map((s) => (
                    <option value={s}>{fmt(s)}</option>
                  ))}
                </select>
              </fieldset>
              <div class="ff">
                <label for="f-dorm">Dormitorios</label>
                <select id="f-dorm" name="dormitorios" class="ff__select">
                  <option value="">Todos</option>
                  {[1, 2, 3, 4].map((n) => (
                    <option value={n}>{n} o más</option>
                  ))}
                </select>
              </div>
              <button type="button" class="filters__more" aria-expanded="false" aria-controls="mas-filtros" data-more-toggle>
                Más filtros <span class="search__badge" data-extra-count hidden />
              </button>
            </div>

            <div class="filters__extra" id="mas-filtros" data-extra>
              {opts.zones.length > 0 && (
                <div class="ff">
                  <label for="f-zona">Zona o barrio</label>
                  <select id="f-zona" name="zona" class="ff__select">
                    <option value="">Todas</option>
                    {opts.zones.map((z) => (
                      <option value={z.value}>
                        {z.label} ({z.count})
                      </option>
                    ))}
                  </select>
                </div>
              )}
              <div class="ff">
                <label for="f-sup">Superficie mínima</label>
                <select id="f-sup" name="superficie_min" class="ff__select">
                  <option value="">Cualquiera</option>
                  {[40, 60, 80, 100, 150, 200, 300].map((s) => (
                    <option value={s}>{s} m² o más</option>
                  ))}
                </select>
              </div>
              <div class="ff">
                <label for="f-banos">Baños</label>
                <select id="f-banos" name="banos" class="ff__select">
                  <option value="">Todos</option>
                  {[1, 2, 3].map((n) => (
                    <option value={n}>{n} o más</option>
                  ))}
                </select>
              </div>
              {features.length > 0 && (
                <fieldset class="ff ff--wide">
                  <legend>Características</legend>
                  <div class="toggles">
                    {features.map((f) => (
                      <label class="toggle">
                        <input type="checkbox" name="extra" value={f.value} />
                        <span>
                          {f.label} <span class="toggle__n">{f.count}</span>
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}
            </div>

            <div class="filters__actions">
              <button type="reset" class="btn btn--ghost" data-reset>
                Limpiar
              </button>
              <button type="submit" class="btn filters__apply" data-apply>
                Ver <span data-apply-count>{all.length}</span> resultados
              </button>
            </div>
          </form>
        </div>
      </div>
    )
  }

  <div class="search__toolbar">
    <p class="search__count" aria-live="polite" aria-atomic="true" data-count>
      <strong>{all.length}</strong> <span>{plural(all.length)}</span>
    </p>
    {
      lastPage > 1 && (
        <p class="search__page" data-page-info>
          Página {page} de {lastPage}
        </p>
      )
    }
    {
      all.length > 1 && (
        <label class="search__sort">
          <span>Ordenar</span>
          <select class="ff__select" name="orden" form="form-filtros" data-sort>
            {SORTS.map((s) => (
              <option value={s.value}>{s.label}</option>
            ))}
          </select>
        </label>
      )
    }
  </div>
  <div class="search__chips" data-chips hidden></div>
  <p class="search__status" role="status" data-status></p>

  <ul class="results" data-results>
    {slice.map((p, i) => <li data-item={p.id} set:html={renderCard(cardModel(p, operation), { heading: 'h2', eager: i < 3 })} />)}
  </ul>

  <div class="search__empty" data-empty hidden={all.length > 0 ? true : undefined}>
    <h2 data-empty-title>{all.length === 0 ? 'Ahora mismo no hay inmuebles publicados' : 'No hay inmuebles con estos filtros'}</h2>
    <p data-empty-text>
      {
        all.length === 0
          ? 'Nuestra cartera cambia cada semana. Cuéntanos qué buscas y te avisaremos en cuanto tengamos algo que encaje.'
          : 'Prueba a quitar alguno de los filtros. Si nos cuentas qué buscas, te avisamos cuando entre algo que encaje.'
      }
    </p>
    <ul class="search__suggest" data-suggest hidden></ul>
    <div class="search__empty-actions">
      {
        all.length > 0 && (
          <button type="button" class="btn btn--ghost" data-clear>
            Quitar todos los filtros
          </button>
        )
      }
      <a class="btn" href={contactHref}>Cuéntanos qué buscas</a>
    </div>
  </div>

  <div class="search__more" data-more-wrap hidden>
    <p data-more-info></p>
    <button type="button" class="btn btn--ghost" data-more>Mostrar más</button>
  </div>

  <Pagination current={page} last={lastPage} base={base} prefix="pagina/" label="Páginas de resultados" />
</div>

<script>
  import { activeCount, criteriaFromParams, criteriaToParams, search, type Criteria, type SearchItem } from '../lib/inventory/filters';
  import { renderCard, type CardModel } from '../lib/inventory/card';
  import type { Operation } from '../lib/inventory/types';

  type Item = SearchItem & { card: CardModel };
  const EXTRA = ['zona', 'superficie_min', 'banos', 'extra'];

  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const operation = root.dataset.operation as Operation;
    const pageSize = Number(root.dataset.pageSize) || 24;
    const staticTotal = Number(root.dataset.total) || 0;
    const form = $<HTMLFormElement>('[data-form]');
    const sort = $<HTMLSelectElement>('[data-sort]');
    const list = $('[data-results]')!;
    const countEl = $('[data-count]')!;
    const status = $('[data-status]')!;
    const applyCount = $('[data-apply-count]');
    const activeBadge = $('[data-active-count]');
    const extraBadge = $('[data-extra-count]');
    const empty = $('[data-empty]')!;
    const emptyTitle = $('[data-empty-title]')!;
    const emptyText = $('[data-empty-text]')!;
    const suggest = $('[data-suggest]')!;
    const moreWrap = $('[data-more-wrap]')!;
    const moreBtn = $<HTMLButtonElement>('[data-more]')!;
    const moreInfo = $('[data-more-info]')!;
    const chips = $('[data-chips]')!;
    const pager = $('[data-pager]');
    const pageInfo = $('[data-page-info]');
    const panel = $('[data-filters]');
    const openBtn = $<HTMLButtonElement>('[data-filters-open]');
    const closeBtn = $<HTMLButtonElement>('[data-filters-close]');
    const moreToggle = $<HTMLButtonElement>('[data-more-toggle]');
    const extra = $('[data-extra]');
    if (!form || !sort) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 959px)');
    const originalPath = location.pathname;
    const staticNodes = [...list.children];
    let mode: 'static' | 'client' = 'static';
    let result: Item[] = [];
    let shown = 0;
    let shownCount = staticTotal;
    let token = 0;

    // --- Índice de búsqueda: se descarga una vez, cuando hace falta ---
    let loading: Promise<Item[]> | null = null;
    const load = () =>
      (loading ??= fetch(root.dataset.src!)
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json() as Promise<{ items: Item[] }>;
        })
        .then((d) => d.items)
        .catch((e) => {
          loading = null;
          throw e;
        }));
    // Intención de filtrar: se adelanta la descarga.
    const prefetch = () => load().catch(() => {});
    root.addEventListener('pointerover', prefetch, { once: true });
    root.addEventListener('focusin', prefetch, { once: true });

    // --- Formulario ⇄ criterios ⇄ URL ---
    function readForm(): Criteria {
      const params = new URLSearchParams();
      new FormData(form!).forEach((v, k) => {
        if (typeof v === 'string' && v !== '') params.append(k, v);
      });
      params.set('orden', sort!.value);
      return criteriaFromParams(params, operation);
    }

    function writeForm(c: Criteria) {
      const set = (name: string, value: string) => {
        const el = form!.elements.namedItem(name);
        if (el instanceof HTMLSelectElement) el.value = [...el.options].some((o) => o.value === value) ? value : '';
      };
      set('ciudad', c.city ?? '');
      set('zona', c.zone ?? '');
      set('tipo', c.typeGroup ?? '');
      set('precio_min', c.priceMin?.toString() ?? '');
      set('precio_max', c.priceMax?.toString() ?? '');
      set('superficie_min', c.areaMin?.toString() ?? '');
      set('dormitorios', c.bedroomsMin?.toString() ?? '');
      set('banos', c.bathroomsMin?.toString() ?? '');
      form!.querySelectorAll<HTMLInputElement>('input[name="extra"]').forEach((cb) => (cb.checked = c.features.includes(cb.value)));
      sort!.value = c.sort;
    }

    const isDefault = (c: Criteria) => activeCount(c) === 0 && c.sort === 'recientes';

    function labelFor(name: string, value: string): string {
      const el = form!.elements.namedItem(name);
      const text = el instanceof HTMLSelectElement ? (el.selectedOptions[0]?.textContent ?? value).replace(/\s*\(\d+\)$/, '') : value;
      if (name === 'precio_min') return `Desde ${text}`;
      if (name === 'precio_max') return `Hasta ${text}`;
      if (name === 'dormitorios') return `${value}+ dormitorios`;
      if (name === 'banos') return `${value}+ baños`;
      if (name === 'superficie_min') return `${value}+ m²`;
      return text;
    }

    function without(c: Criteria, key: string, value: string): Criteria {
      const next = criteriaToParams(c);
      const keep = next.getAll(key).filter((x) => x !== value);
      next.delete(key);
      keep.forEach((x) => next.append(key, x));
      return criteriaFromParams(next, operation);
    }

    function renderChips(c: Criteria) {
      const params = criteriaToParams(c);
      params.delete('orden');
      const entries = [...params.entries()];
      chips.replaceChildren();
      chips.hidden = entries.length === 0;
      for (const [k, v] of entries) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'filter-chip';
        b.textContent = labelFor(k, v);
        b.setAttribute('aria-label', `Quitar filtro: ${b.textContent}`);
        b.addEventListener('click', () => {
          writeForm(without(readForm(), k, v));
          update();
        });
        chips.append(b);
      }
      if (entries.length > 1) {
        const clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'filter-chip filter-chip--clear';
        clear.textContent = 'Quitar todos';
        clear.addEventListener('click', clearAll);
        chips.append(clear);
      }
      const active = activeCount(c);
      if (activeBadge) {
        activeBadge.hidden = active === 0;
        activeBadge.textContent = String(active);
      }
      const extraActive = entries.filter(([k]) => EXTRA.includes(k)).length;
      if (extraBadge) {
        extraBadge.hidden = extraActive === 0;
        extraBadge.textContent = String(extraActive);
      }
    }

    // --- Recuento con transición numérica ---
    function setCount(n: number) {
      const from = shownCount;
      shownCount = n;
      const strong = countEl.querySelector('strong')!;
      countEl.querySelector('span')!.textContent = n === 1 ? 'inmueble' : 'inmuebles';
      if (applyCount) applyCount.textContent = String(n);
      if (reduce.matches || from === n) {
        strong.textContent = String(n);
        return;
      }
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 380);
        strong.textContent = String(Math.round(from + (n - from) * (1 - Math.pow(1 - k, 3))));
        if (k < 1 && shownCount === n) requestAnimationFrame(step);
        else if (shownCount === n) strong.textContent = String(n);
      };
      requestAnimationFrame(step);
    }

    // --- Pintado incremental ---
    function appendNext(focusFirst = false) {
      const next = result.slice(shown, shown + pageSize);
      const frag = document.createDocumentFragment();
      next.forEach((it, i) => {
        const li = document.createElement('li');
        li.dataset.item = it.id;
        li.className = 'is-new';
        li.style.setProperty('--i', String(Math.min(i, 8)));
        li.innerHTML = renderCard(it.card, { heading: 'h2', eager: shown === 0 && i < 3 });
        frag.append(li);
      });
      const firstNew = frag.firstElementChild as HTMLElement | null;
      list.append(frag);
      shown += next.length;
      const left = result.length - shown;
      moreWrap.hidden = left <= 0;
      moreInfo.textContent = `Mostrando ${shown} de ${result.length}`;
      moreBtn.textContent = `Mostrar ${Math.min(left, pageSize)} más`;
      if (focusFirst) firstNew?.querySelector<HTMLAnchorElement>('a')?.focus();
    }

    function showStatic() {
      if (mode === 'client') list.replaceChildren(...staticNodes);
      mode = 'static';
      setCount(staticTotal);
      moreWrap.hidden = true;
      empty.hidden = staticTotal > 0;
      if (pager) pager.hidden = false;
      if (pageInfo) pageInfo.hidden = false;
    }

    function renderEmpty(c: Criteria, items: Item[]) {
      emptyTitle.textContent = 'No hay inmuebles con estos filtros';
      emptyText.textContent = 'Prueba a quitar alguno de los filtros. Si nos cuentas qué buscas, te avisamos cuando entre algo que encaje.';
      // Qué filtro conviene quitar: los que más resultados devuelven al quitarlos.
      const params = criteriaToParams(c);
      params.delete('orden');
      const options = [...params.entries()]
        .map(([k, v]) => ({ k, v, n: search(items, without(c, k, v)).length }))
        .filter((o) => o.n > 0)
        .sort((a, b) => b.n - a.n)
        .slice(0, 3);
      suggest.replaceChildren(
        ...options.map((o) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'link-arrow';
          b.textContent = `Sin «${labelFor(o.k, o.v)}»: ${o.n} ${o.n === 1 ? 'inmueble' : 'inmuebles'}`;
          b.addEventListener('click', () => {
            writeForm(without(readForm(), o.k, o.v));
            update();
          });
          li.append(b);
          return li;
        }),
      );
      suggest.hidden = options.length === 0;
    }

    async function update(pushUrl = true) {
      const c = readForm();
      renderChips(c);
      const qs = criteriaToParams(c).toString();
      if (pushUrl) {
        const path = isDefault(c) ? originalPath : root.dataset.base!;
        history.replaceState(null, '', qs ? `${path}?${qs}` : path);
      }
      if (isDefault(c)) return showStatic();

      const mine = ++token;
      list.setAttribute('aria-busy', 'true');
      root.classList.add('is-loading');
      let items: Item[];
      try {
        items = await load();
      } catch {
        if (mine !== token) return;
        list.removeAttribute('aria-busy');
        root.classList.remove('is-loading');
        status.textContent = 'No se ha podido cargar el buscador. Comprueba la conexión y vuelve a intentarlo.';
        return;
      }
      if (mine !== token) return;
      status.textContent = '';
      list.removeAttribute('aria-busy');
      root.classList.remove('is-loading');
      mode = 'client';
      result = search(items, c) as Item[];
      shown = 0;
      list.replaceChildren();
      appendNext();
      setCount(result.length);
      empty.hidden = result.length > 0;
      if (!result.length) renderEmpty(c, items);
      if (pager) pager.hidden = true;
      if (pageInfo) pageInfo.hidden = true;
    }

    function clearAll() {
      form!.reset();
      sort!.value = 'recientes';
      update();
    }

    // --- «Más filtros» (escritorio) ---
    function setExtra(open: boolean) {
      moreToggle?.setAttribute('aria-expanded', String(open));
      extra?.classList.toggle('is-open', open);
    }
    moreToggle?.addEventListener('click', () => setExtra(moreToggle.getAttribute('aria-expanded') !== 'true'));

    // --- Panel de filtros en móvil (diálogo accesible) ---
    function openPanel() {
      if (!panel) return;
      panel.classList.add('is-open');
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-modal', 'true');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('filters-open');
      closeBtn?.focus();
    }
    function closePanel(focus = true) {
      if (!panel) return;
      panel.classList.remove('is-open');
      panel.removeAttribute('role');
      panel.removeAttribute('aria-modal');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('filters-open');
      if (focus) openBtn?.focus();
    }
    openBtn?.addEventListener('click', openPanel);
    closeBtn?.addEventListener('click', () => closePanel());
    panel?.addEventListener('keydown', (e) => {
      if (!panel.classList.contains('is-open')) return;
      if (e.key === 'Escape') closePanel();
      if (e.key === 'Tab') {
        const f = [...panel.querySelectorAll<HTMLElement>('button, select, input, a[href]')].filter(
          (el) => !el.hasAttribute('disabled') && el.offsetParent !== null,
        );
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
    });
    mobile.addEventListener('change', (e) => {
      if (!e.matches) closePanel(false);
    });

    // --- Eventos ---
    form.addEventListener('change', () => update());
    sort.addEventListener('change', () => update());
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      update();
      if (mobile.matches) closePanel();
      countEl.scrollIntoView({ block: 'center' });
    });
    form.addEventListener('reset', () => setTimeout(() => update()));
    root.querySelector('[data-clear]')?.addEventListener('click', clearAll);
    moreBtn.addEventListener('click', () => appendNext(true));

    // Estado inicial desde la URL (búsqueda compartida o recargada).
    const initial = criteriaFromParams(new URLSearchParams(location.search), operation);
    writeForm(initial);
    if (EXTRA.some((k) => new URLSearchParams(location.search).has(k))) setExtra(true);
    if (!isDefault(initial)) update(false);
    else renderChips(initial);
    root.classList.add('is-ready');
  }
</script>

<style>
  /* ---------- Barra de filtros ---------- */
  .search__bar {
    display: none;
    margin-bottom: var(--s-6);
  }
  :global(.js) .search__bar {
    display: block;
  }
  .ff {
    display: grid;
    gap: 2px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .ff label,
  .ff legend,
  .search__sort span {
    padding: 0;
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
