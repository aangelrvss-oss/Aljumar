---
/**
 * Logotipo corporativo. Se usa SIEMPRE el archivo original de Aljumar, sin
 * redibujarlo. Versiones claras para fondo azul, con transparencia, en
 * public/brand/:
 *
 *   logo-horizontal.png   (cabecera)
 *   logo-vertical.png     (pie, presentación de marca)
 *
 * Se obtuvieron de las capturas de la web oficial (ver
 * migration/brand-captures/). Si Aljumar entrega los vectoriales, basta con
 * dejarlos como logo-*.svg: se usan con preferencia. Si no existe ningún
 * archivo, se muestra el nombre en texto (sin imitar el símbolo) y
 * `npm run check` lo marca como pendiente.
 */
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { site } from '../data/site';

interface Props {
  variant?: 'horizontal' | 'vertical' | 'simbolo';
  height?: number;
  class?: string;
  /** Texto alternativo; vacío si el logotipo es decorativo en ese contexto. */
  alt?: string;
}
const { variant = 'horizontal', height = 48, class: className, alt = site.name } = Astro.props;

const publicDir = resolve(process.cwd(), 'public');
const file = ['svg', 'png'].map((ext) => `/brand/logo-${variant}.${ext}`).find((c) => existsSync(resolve(publicDir, '.' + c)));

// Dimensiones intrínsecas del PNG (cabecera IHDR) para reservar el hueco.
let width: number | undefined;
if (file?.endsWith('.png')) {
  const buf = readFileSync(resolve(publicDir, '.' + file));
  width = Math.round((buf.readUInt32BE(16) / buf.readUInt32BE(20)) * height);
}
---

{
  file ? (
    <img class:list={['logo', `logo--${variant}`, className]} src={file} alt={alt} width={width} height={height} decoding="async" />
  ) : (
    <span class:list={['logo-text', className]} data-logo-pending>
      <span class="logo-text__name">Aljumar</span>
      <span class="logo-text__sub">Inmuebles</span>
    </span>
  )
}

<style>
  .logo {
    display: block;
  }
  .logo-text {
    display: inline-grid;
    line-height: 1;
    font-family: var(--font-sans);
    text-transform: uppercase;
    color: var(--white);
  }
  .logo-text__name {
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: 0.06em;
  }
  .logo-text__sub {
    margin-top: 4px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.42em;
    color: var(--lime-500);
  }
</style>
