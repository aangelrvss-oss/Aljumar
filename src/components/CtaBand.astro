---
import { site } from '../data/site';

interface Props {
  title: string;
  text: string;
  primary: { label: string; href: string };
  showPhone?: boolean;
}
const { title, text, primary, showPhone = true } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <h2 id="cta-title" data-motion="up">{title}</h2>
    <div class="cta__side" data-motion="up">
      <p>{text}</p>
      <div class="cta__actions">
        <a class="btn btn--accent" href={primary.href}>{primary.label}</a>
        {
          showPhone && (
            <a class="link-arrow" href={`tel:${site.phones.office.tel}`}>
              Llamar al {site.phones.office.display}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--paper-2);
    color: var(--ink-2);
    padding-block: var(--s-9);
    border-top: 1px solid var(--line);
  }
  .cta__inner {
    display: grid;
    gap: var(--s-5) var(--s-8);
    align-items: end;
  }
  .cta h2 {
    margin: 0;
    font-size: var(--fs-2xl);
    max-width: 16ch;
  }
  .cta p {
    max-width: 48ch;
    margin: 0 0 var(--s-5);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
  }
  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
