---
/**
 * Presentación de marca al entrar en la portada: el logotipo original aparece
 * sobre el azul corporativo y la cortina se retira hacia arriba descubriendo
 * la página. ≈ 800 ms en total.
 *
 * - Una vez por sesión (sessionStorage), solo si el usuario no ha pedido
 *   reducir el movimiento.
 * - No bloquea: la capa no recibe eventos (pointer-events: none) y la página
 *   ya está cargada y es interactiva debajo; no desplaza nada (position: fixed).
 * - Sin JavaScript la clase `reveal` no se añade y la capa nunca se muestra.
 * - Si las animaciones CSS no llegan a ejecutarse, un temporizador retira la
 *   capa a los 1,2 s (clase `intro-done`).
 * - Es decorativa (aria-hidden): los lectores de pantalla no la anuncian.
 *
 *   part="head"  → script en <head> (antes de pintar) + precarga del logotipo
 *   (por defecto) → la capa, al principio de <body>
 */
interface Props {
  part?: 'head' | 'body';
}
const { part = 'body' } = Astro.props;
const logo = '/brand/logo-vertical.png';
---

{
  part === 'head' ? (
    <>
      <script is:inline>
        (function () {
          try {
            if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
            if (sessionStorage.getItem('aljumar-intro')) return;
            sessionStorage.setItem('aljumar-intro', '1');
            var html = document.documentElement;
            html.classList.add('reveal');
            setTimeout(function () {
              html.classList.add('intro-done');
            }, 1200);
          } catch (e) {}
        })();
      </script>
      <link rel="preload" as="image" href={logo} fetchpriority="high" />
    </>
  ) : (
    <div class="intro" aria-hidden="true">
      <div class="intro__mark">
        <img src={logo} alt="" width="188" height="168" decoding="sync" />
        <span class="intro__line" />
      </div>
    </div>
  )
}

<style is:global>
  .intro {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    html.reveal:not(.intro-done) .intro {
      position: fixed;
      inset: 0;
      z-index: 300;
      display: grid;
      place-items: center;
      background: var(--navy-900);
      pointer-events: none;
      animation: intro-out 420ms cubic-bezier(0.76, 0, 0.24, 1) 360ms forwards;
    }
    html.reveal .intro__mark {
      position: relative;
      display: grid;
      justify-items: center;
      gap: 18px;
      animation: intro-mark-out 420ms cubic-bezier(0.76, 0, 0.24, 1) 360ms forwards;
    }
    html.reveal .intro img {
      width: clamp(120px, 22vw, 188px);
      height: auto;
      animation: intro-logo 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    html.reveal .intro__line {
      width: 64px;
      height: 1px;
      background: var(--lime-500);
      transform-origin: left;
      animation: intro-line 380ms cubic-bezier(0.16, 1, 0.3, 1) 60ms both;
    }
  }
  @keyframes intro-logo {
    from {
      opacity: 0;
      clip-path: inset(100% 0 0 0);
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      clip-path: inset(0);
      transform: none;
    }
  }
  @keyframes intro-line {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes intro-mark-out {
    to {
      transform: translateY(-40px);
      opacity: 0;
    }
  }
  @keyframes intro-out {
    to {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }
</style>
