---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
---

<Base
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: title, href: path },
  ]}
>
  <article class="legal">
    <header class="page-head legal__head">
      <div class="container container--narrow">
        <p class="label">Información legal</p>
        <h1>{title}</h1>
        <p class="muted">Última actualización: {updated}</p>
      </div>
    </header>
    <div class="container container--narrow legal__body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal__head {
    padding-bottom: var(--s-7);
  }
  .legal__head h1 {
    font-size: var(--fs-2xl);
  }
  .legal__head p.muted {
    margin: 0;
    font-size: var(--fs-sm);
  }
  .legal__body {
    padding-block: var(--s-7) var(--section);
  }
  .legal :global(.prose) {
    font-size: var(--fs-base);
  }
  .legal :global(.prose > p:first-child) {
    font-size: var(--fs-base);
    color: var(--ink);
  }
</style>
