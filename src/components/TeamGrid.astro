---
/**
 * Equipo. Las fotos son las publicadas en la web actual (wp-content) y se
 * descargan con `npm run media:fetch`. Si un retrato no está en public/, la
 * persona aparece solo con su nombre (sin iniciales ni siluetas de relleno).
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { team } from '../data/site';

const members = team.map((m) => ({ ...m, hasPhoto: existsSync(resolve(process.cwd(), 'public', '.' + m.photo)) }));
const withPhotos = members.some((m) => m.hasPhoto);
---

<ul class:list={['team', { 'team--photos': withPhotos }]}>
  {
    members.map((m) => (
      <li class="team__member" data-motion="up">
        {m.hasPhoto && <img src={m.photo} alt={`Retrato de ${m.name}`} width="320" height="400" loading="lazy" decoding="async" />}
        <p class="team__name">{m.name}</p>
        {m.role && <p class="team__role">{m.role}</p>}
      </li>
    ))
  }
</ul>

<style>
  .team {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .team__member {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line-strong);
  }
  .team--photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    gap: var(--s-6) var(--s-5);
    border-top: 0;
  }
  .team--photos .team__member {
    display: block;
    border-bottom: 0;
    padding: 0;
  }
  .team__member img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: var(--s-3);
    background: var(--paper-2);
  }
  .team__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 380;
    font-variation-settings: 'opsz' 72;
    color: var(--navy-900);
  }
  .team__role {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
</style>
