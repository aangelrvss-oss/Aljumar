---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

// Servicios tal y como los describe Aljumar en su web actual («¿Quieres vender?»).
const services = [
  { title: 'Informe de valoración sin compromiso', text: 'Analizamos tu vivienda y el mercado para determinar su valor real de venta y aconsejarte el precio de salida.' },
  { title: 'Preparación de la vivienda', text: 'La preparamos para la venta y le sacamos el máximo partido, para que sea un hogar deseable que llame la atención.' },
  { title: 'Más compradores', text: 'Disponemos de una amplia base de datos de compradores y vendedores, gracias también a nuestra colaboración con varias MLS (redes de agencias) de la zona.' },
  { title: 'Compradores filtrados', text: 'Analizamos a los candidatos y descartamos a quienes no cumplen los requisitos de solvencia y fiabilidad.' },
  { title: 'Trámites resueltos', text: 'Te ayudamos con los trámites legales y financieros para que tengas todos los papeles en orden.' },
  { title: 'Conocimiento de la zona', text: `Más de ${new Date().getFullYear() - site.foundingYear - 1} años trabajando en Moratalaz: conocemos sus viviendas, calles y compradores.` },
];

const flow = [
  { title: 'Te llamamos', text: 'Revisamos tu solicitud y te llamamos en horario de oficina para conocer tu situación, tus plazos y tus dudas.' },
  { title: 'Visitamos y valoramos', text: 'Vemos la vivienda y preparamos un informe de valoración con su valor real de venta según el mercado de la zona.' },
  { title: 'Te proponemos un plan', text: 'Precio de salida, cómo presentar la vivienda y cómo llegar a más compradores. Si no te convence, no hay compromiso.' },
  { title: 'Vendemos contigo', text: 'Organizamos las visitas, filtramos a los compradores, negociamos y te ayudamos con toda la documentación.' },
];

const faqs = [
  {
    q: '¿La valoración tiene algún coste o compromiso?',
    a: 'No. El informe de valoración es sin compromiso: te explicamos cómo hemos llegado al precio y decides después con calma si quieres vender con nosotros.',
  },
  {
    q: '¿Trabajáis en exclusiva?',
    a: 'Sí. Somos una agencia dedicada a la compraventa de inmuebles en exclusiva. Te explicaremos con detalle las condiciones antes de firmar nada.',
  },
  {
    q: '¿Qué documentos necesito para vender?',
    a: 'Entre otros, la nota simple, el certificado energético, la escritura, el último recibo del IBI y el certificado de deuda con la comunidad. Te ayudamos a reunirlos y tienes la lista completa en nuestro artículo sobre documentación.',
    link: { href: '/check-list-de-los-documentos-que-necesitas-para-vender-tu-propiedad/', label: 'Ver la lista de documentos' },
  },
  {
    q: '¿También gestionáis alquileres?',
    a: 'Sí. Si prefieres alquilar tu vivienda, analizamos el mercado, te asesoramos sobre el precio y buscamos inquilinos que encajen.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Vender mi vivienda en Moratalaz y Madrid: valoración sin compromiso"
  description="¿Vendes tu piso en Moratalaz o Madrid? Valoración sin compromiso, preparación de la vivienda, compradores filtrados y ayuda con todos los trámites."
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Vender mi vivienda', href: '/vender-mi-vivienda/' },
  ]}
  jsonLd={[faqSchema]}
  contactFormHref="#formulario"
>
  <section class="sell-hero">
    <div class="container sell-hero__grid">
      <div class="sell-hero__copy">
        <p class="label" data-hero style="--i:0">Propietarios</p>
        <h1 data-hero style="--i:1">Vende tu vivienda con <em>quien conoce tu barrio</em></h1>
        <p class="lead" data-hero style="--i:2">
          Te decimos cuánto vale de verdad, la preparamos para el mercado y la ponemos delante de compradores solventes. Te
          acompañamos durante todo el proceso.
        </p>
        <ul class="promises" data-hero style="--i:3">
          <li>Valoración sin compromiso</li>
          <li>Trámites legales y financieros resueltos</li>
          <li>Desde {site.foundingYear} en Moratalaz</li>
        </ul>
      </div>
      <div class="sell-form" id="solicitar" data-hero style="--i:2">
        <ContactForm
          variant="vender"
          id="formulario"
          heading="Cuéntanos sobre tu inmueble"
          intro="Solo lo imprescindible. Te llamamos para conocer tu situación y concertar la visita de valoración."
        />
      </div>
    </div>
  </section>

  <section class="section flow-section" aria-labelledby="que-pasa">
    <div class="container">
      <div class="head">
        <p class="label">Qué pasa después</p>
        <h2 id="que-pasa">Así trabajamos <em>contigo</em></h2>
        <p class="muted">Sin prisas ni compromisos: en cada paso decides tú.</p>
      </div>
      <ol class="flow">
        {
          flow.map((f, i) => (
            <li data-motion="up">
              <span class="flow__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--navy on-dark" aria-labelledby="servicios-vender">
    <div class="container services-grid">
      <div class="services-grid__intro" data-motion="up">
        <p class="label">Qué incluye</p>
        <h2 id="servicios-vender">Un servicio pensado para <em>sacar el máximo valor</em> a tu vivienda</h2>
        <a class="btn btn--accent" href="#formulario">Solicitar valoración</a>
      </div>
      <dl class="services">
        {
          services.map((s) => (
            <div data-motion="up">
              <dt>{s.title}</dt>
              <dd>{s.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="faq">
    <div class="container faq-grid">
      <div>
        <p class="label">Dudas habituales</p>
        <h2 id="faq">Preguntas <em>frecuentes</em></h2>
      </div>
      <div>
        <div class="faq">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="faq__a">
                  <p>{f.a}</p>
                  {f.link && (
                    <a class="link-arrow" href={f.link.href}>
                      {f.link.label}
                    </a>
                  )}
                </div>
              </details>
            ))
          }
        </div>
        <p class="faq__more">
          ¿Prefieres hablarlo por teléfono? Llámanos al <a href={`tel:${site.phones.office.tel}`}>{site.phones.office.display}</a> o al
          <a href={`tel:${site.phones.mobile.tel}`}>{site.phones.mobile.display}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .sell-hero {
    padding-block: var(--s-6) var(--section);
    background: var(--paper);
  }
  .sell-hero__grid {
    display: grid;
    gap: var(--s-7);
  }
  .sell-hero h1 {
    font-size: var(--fs-3xl);
    max-width: 14ch;
  }
  .promises {
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
    max-width: 30rem;
  }
  .promises li {
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--line-strong);
    font-weight: 600;
    color: var(--navy-900);
  }
  .sell-form {
    padding: var(--s-6) var(--s-5);
    background: var(--white);
    border-top: 3px solid var(--navy-900);
    box-shadow: var(--shadow-float);
  }
  .head {
    margin-bottom: var(--s-7);
  }
  .head h2 {
    margin-bottom: var(--s-2);
  }
  .flow {
    display: grid;
    gap: var(--s-6) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow li {
    padding-top: var(--s-4);
    border-top: 1px solid var(--navy-900);
  }
  .flow__n {
    display: block;
    margin-bottom: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-style: italic;
    font-weight: 330;
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--navy-500);
  }
  .flow h3 {
    margin-bottom: var(--s-2);
  }
  .flow p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .services-grid {
    display: grid;
    gap: var(--s-7);
  }
  .services-grid h2 {
    font-size: var(--fs-2xl);
    max-width: 16ch;
    margin-bottom: var(--s-6);
  }
  .services-grid h2 em {
    color: var(--lime-500);
  }
  .services {
    display: grid;
    gap: 0 var(--s-6);
    margin: 0;
  }
  .services div {
    padding-block: var(--s-5);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .services dt {
    margin-bottom: var(--s-2);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 380;
    font-variation-settings: 'opsz' 72;
    color: var(--white);
  }
  .services dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--navy-200);
  }
  .faq-grid {
    display: grid;
    gap: var(--s-6);
  }
  .faq-grid h2 {
    font-size: var(--fs-2xl);
  }
  .faq__more {
    margin-top: var(--s-5);
    color: var(--ink-2);
  }
  @media (min-width: 720px) {
    .flow {
      grid-template-columns: repeat(2, 1fr);
    }
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .sell-hero__grid {
      grid-template-columns: 6fr 5fr;
      gap: var(--s-9);
      align-items: start;
    }
    .sell-hero__copy {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      padding-top: var(--s-6);
    }
    .flow {
      grid-template-columns: repeat(4, 1fr);
    }
    .services-grid {
      grid-template-columns: 4fr 1fr 7fr;
    }
    .services {
      grid-column: 3;
    }
    .services-grid__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
    .faq-grid {
      grid-template-columns: 4fr 1fr 7fr;
    }
    .faq-grid > div:last-child {
      grid-column: 3;
    }
  }
</style>
