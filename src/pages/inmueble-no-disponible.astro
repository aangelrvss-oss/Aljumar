---
/**
 * Página que se sirve (con estado 410 Gone, ver .htaccess) cuando un inmueble
 * deja de publicarse en Inmovilla: vendido, alquilado o retirado. Así el
 * visitante que llega desde un portal o un buscador encuentra alternativas, y
 * los buscadores retiran la ficha del índice.
 */
import Base from '../layouts/Base.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { featured } from '../lib/inventory';

const others = featured(3);
---

<Base title="Este inmueble ya no está disponible" description="El inmueble que buscabas ya no está publicado." noindex>
  <section class="page-head">
    <div class="container">
      <p class="label" data-hero style="--i:0">Inmueble no disponible</p>
      <h1 data-hero style="--i:1">Este inmueble <em>ya no está disponible</em></h1>
      <p class="lead" data-hero style="--i:2">
        Se ha vendido, alquilado o retirado del mercado. Te dejamos otras viviendas de nuestra cartera; si buscabas algo
        parecido, cuéntanoslo y te avisaremos cuando entre.
      </p>
      <p class="gone__actions" data-hero style="--i:3">
        <a class="btn btn--accent" href="/contacto/?motivo=comprar#formulario">Avisadme de inmuebles parecidos</a>
        <a class="link-arrow" href="/comprar/">Viviendas en venta</a>
        <a class="link-arrow" href="/alquilar/">Viviendas en alquiler</a>
      </p>
    </div>
  </section>
  {
    others.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="gone__title">Otros inmuebles de nuestra cartera</h2>
          <ul class="gone__list">
            {others.map((p) => (
              <li>
                <PropertyCard property={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .gone__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin: var(--s-6) 0 0;
  }
  .gone__title {
    font-size: var(--fs-xl);
    margin-bottom: var(--s-6);
  }
  .gone__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--s-6) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
