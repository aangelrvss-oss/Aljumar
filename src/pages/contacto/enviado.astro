---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---

<Base title="Mensaje enviado" description="Hemos recibido tu mensaje." noindex>
  <section class="page-head">
    <div class="container">
      <p class="label" data-hero style="--i:0">Gracias</p>
      <h1 data-hero style="--i:1">Hemos recibido <em>tu mensaje</em></h1>
      <p class="lead" data-hero style="--i:2">
        Te responderemos lo antes posible en horario de oficina. Si es urgente, llámanos al
        <a href={`tel:${site.phones.office.tel}`}>{site.phones.office.display}</a>.
      </p>
      <ul class="exits" data-hero style="--i:3">
        <li><a href="/comprar/">Ver inmuebles en venta</a></li>
        <li><a href="/">Volver al inicio</a></li>
      </ul>
    </div>
  </section>
</Base>
