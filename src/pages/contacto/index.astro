---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site } from '../../data/site';
---

<Base
  title="Contacto: oficina en Moratalaz, teléfono y correo"
  description={`Contacta con Aljumar Inmuebles: ${site.phones.office.display}, ${site.email} o en nuestra oficina de ${site.address.street}, ${site.address.postalCode} Madrid (Moratalaz).`}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Contacto', href: '/contacto/' },
  ]}
  contactFormHref="#formulario"
>
  <section class="contact">
    <div class="container contact__grid">
      <div class="contact__info">
        <p class="label" data-hero style="--i:0">Contacto</p>
        <h1 data-hero style="--i:1">¿En qué podemos <em>ayudarte?</em></h1>
        <p class="lead" data-hero style="--i:2">Llámanos, escríbenos o ven a vernos. Te atendemos personalmente.</p>

        <a class="contact__phone" href={`tel:${site.phones.office.tel}`} data-hero style="--i:3">{site.phones.office.display}</a>

        <dl class="channels" data-hero style="--i:4">
          <div>
            <dt>Móvil</dt>
            <dd><a class="link" href={`tel:${site.phones.mobile.tel}`}>{site.phones.mobile.display}</a></dd>
          </div>
          <div>
            <dt>Correo</dt>
            <dd><a class="link" href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          {
            site.openingHours && (
              <div>
                <dt>Horario</dt>
                <dd>{site.openingHours}</dd>
              </div>
            )
          }
          <div>
            <dt>Oficina</dt>
            <dd>
              {site.address.street}, {site.address.postalCode} {site.address.city} ({site.address.note})<br />
              <a class="link" href={site.mapUrl} target="_blank" rel="noopener">
                Ver en el mapa<span class="visually-hidden"> (abre una pestaña nueva)</span>
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="contact__form" data-hero style="--i:2">
        <ContactForm variant="general" id="formulario" heading="Escríbenos" intro="Cuéntanos qué necesitas y te responderemos lo antes posible." />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-block: var(--s-6) var(--section);
    background: var(--paper);
  }
  .contact__grid {
    display: grid;
    gap: var(--s-7);
  }
  .contact h1 {
    font-size: var(--fs-3xl);
    max-width: 12ch;
  }
  .contact__phone {
    display: inline-block;
    margin: var(--s-6) 0 var(--s-5);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 360;
    font-variation-settings: 'opsz' 144;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.02em;
    color: var(--navy-900);
    text-decoration: none;
    background: linear-gradient(var(--lime-500), var(--lime-500)) 0 100% / 0 2px no-repeat;
    transition: background-size 500ms var(--ease-out);
  }
  .contact__phone:hover {
    background-size: 100% 2px;
  }
  .channels {
    margin: 0;
    border-top: 1px solid var(--line-strong);
    max-width: 34rem;
  }
  .channels div {
    display: grid;
    gap: var(--s-1) var(--s-5);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--line-strong);
  }
  .channels dt {
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .channels dd {
    margin: 0;
    color: var(--navy-900);
  }
  .contact__form {
    padding: var(--s-6) var(--s-5);
    background: var(--white);
    border-top: 3px solid var(--navy-900);
    box-shadow: var(--shadow-float);
  }
  @media (min-width: 720px) {
    .channels div {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
    }
  }
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--s-9);
      align-items: start;
    }
    .contact__info {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      padding-top: var(--s-5);
    }
  }
</style>
