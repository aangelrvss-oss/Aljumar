---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe o ha cambiado de dirección." noindex>
  <section class="page-head">
    <div class="container">
      <p class="label" data-hero style="--i:0">Error 404</p>
      <h1 data-hero style="--i:1">No encontramos esta página</h1>
      <p class="lead" data-hero style="--i:2">Puede que la dirección haya cambiado con la nueva web o que el contenido ya no exista.</p>
      <ul class="exits" data-hero style="--i:3">
        <li><a href="/comprar/">Viviendas en venta</a></li>
        <li><a href="/alquilar/">Viviendas en alquiler</a></li>
        <li><a href="/vender-mi-vivienda/">Vender mi vivienda</a></li>
        <li><a href="/consejos-inmobiliarios/">Consejos inmobiliarios</a></li>
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </div>
  </section>
</Base>
