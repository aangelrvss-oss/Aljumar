---
/**
 * Páginas 2, 3… de los listados (/comprar/pagina/2/). La primera es
 * /comprar/ (src/pages/comprar.astro). Solo se generan si hay más de una.
 */
import type { GetStaticPaths } from 'astro';
import ListingPage from '../../../components/ListingPage.astro';
import { byOperation } from '../../../lib/inventory';
import { LISTING_BASE, OPERATIONS, PAGE_SIZE } from '../../../lib/inventory/listing';
import type { Operation } from '../../../lib/inventory/types';

export const getStaticPaths = (() =>
  OPERATIONS.flatMap((operation) => {
    const last = Math.ceil(byOperation(operation).length / PAGE_SIZE);
    return Array.from({ length: Math.max(0, last - 1) }, (_, i) => ({
      params: { listing: LISTING_BASE[operation].replaceAll('/', ''), page: String(i + 2) },
      props: { operation, page: i + 2 },
    }));
  })) satisfies GetStaticPaths;

const { operation, page } = Astro.props as { operation: Operation; page: number };
---

<ListingPage operation={operation} page={page} />
