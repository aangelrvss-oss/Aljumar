---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import QuickSearch from '../components/QuickSearch.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { allProperties, byOperation, featured, heroProperty } from '../lib/inventory';
import { formatPrice, headline, priceFor, primaryOperation } from '../lib/inventory/format';
import { site, team } from '../data/site';
import { topics } from '../data/topics';

// Foto principal: regla documentada en heroProperty() (src/lib/inventory).
const hero = heroProperty();
const heroOp = hero ? primaryOperation(hero) : 'venta';
// Solo se amplía la primera tarjeta si Aljumar la ha marcado como destacada
// en Inmovilla: ampliar sin criterio puede agrandar una foto de un baño o un
// plano. Sin destacados, rejilla uniforme de 4.
const candidates = featured(5, hero?.id ?? null);
const hasLead = candidates[0]?.featured === true;
const highlights = hasLead ? candidates : candidates.slice(0, 4);

const posts = (await getCollection('blog', (e) => !e.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((p) => p.data.topic !== 'hogar-y-reformas')
  .slice(0, 4);
const [leadPost, ...morePosts] = posts;
const date = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const years = new Date().getFullYear() - site.foundingYear;
const counts = { venta: byOperation('venta').length, alquiler: byOperation('alquiler').length };
const total = allProperties().length;
// Lugares con inmuebles publicados ahora mismo (no una lista fija).
const places = [...new Set(allProperties().map((p) => p.zone ?? p.city).filter((x): x is string => Boolean(x)))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);

const method = [
  { title: 'Hablamos', text: 'Nos cuentas tu situación y tus plazos, sin compromiso.' },
  { title: 'Valoramos', text: 'Analizamos tu vivienda y el mercado de la zona para fijar un precio de salida realista.' },
  {
    title: 'Preparamos y difundimos',
    text: 'Preparamos la vivienda para que llame la atención y la damos a conocer para llegar a más compradores o inquilinos.',
  },
  {
    title: 'Filtramos y acompañamos',
    text: 'Descartamos a los candidatos que no cumplen los requisitos de solvencia, organizamos las visitas y te ayudamos con la documentación legal y financiera.',
  },
];
---

<Base
  title="Inmobiliaria en Moratalaz, Madrid | Aljumar Inmuebles desde 1998"
  rawTitle
  intro
  description="Aljumar Inmuebles: inmobiliaria en Moratalaz (Madrid) desde 1998. Pisos en venta y alquiler, valoración de tu vivienda sin compromiso y acompañamiento en todo el proceso."
>
  <!-- 1. Portada: titular, una fotografía real y el buscador -->
  <section class:list={['hero', { 'hero--nophoto': !hero }]} aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="label" data-hero style="--i:0">Moratalaz, Madrid · desde {site.foundingYear}</p>
        <h1 id="hero-title" class="hero__title" data-hero style="--i:1">
          Tu casa en Madrid, en manos de <em>quien conoce el barrio</em>.
        </h1>
        <p class="lead" data-hero style="--i:2">
          Vendemos y alquilamos viviendas y te ayudamos a encontrar la tuya. Te atendemos en persona y te acompañamos en
          cada paso, de la valoración a la firma.
        </p>
      </div>

      {
        hero && (
          <figure class="hero__figure" data-hero="photo" style="--i:1">
            <div class="hero__photo">
              <img
                src={hero.photos[0]!.url}
                alt={hero.photos[0]!.alt}
                width="960"
                height="1200"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-fallback
              />
            </div>
            <figcaption class="hero__caption">
              <span class="hero__caption-label">En cartera</span>
              <a href={`/inmueble/${hero.slug}/`} class="hero__caption-link">
                <span>{headline(hero)}</span>
                <strong>{formatPrice(priceFor(hero, heroOp), heroOp)}</strong>
              </a>
            </figcaption>
          </figure>
        )
      }

      <div class="hero__search" data-hero style="--i:3">
        <QuickSearch />
      </div>
    </div>
  </section>

  <!-- 2. Cartera -->
  <section class="section featured" aria-labelledby="destacados">
    <div class="container">
      <div class="head">
        <div>
          <p class="label">Cartera</p>
          <h2 id="destacados">Disponibles <em>ahora</em></h2>
        </div>
        <p class="head__links">
          <a class="link-arrow" href="/comprar/">{counts.venta} en venta</a>
          {counts.alquiler > 0 && <a class="link-arrow" href="/alquilar/">{counts.alquiler} en alquiler</a>}
        </p>
      </div>
      {
        highlights.length > 0 ? (
          <ul class="featured__list" aria-label="Inmuebles destacados">
            {highlights.map((p, i) => (
              <li class:list={['featured__item', { 'featured__item--lead': hasLead && i === 0 }]} data-motion="up">
                <PropertyCard property={p} showOperation={counts.alquiler > 0} />
              </li>
            ))}
          </ul>
        ) : (
          !hero && (
            <p class="alert alert--info">
              Estamos actualizando nuestra cartera. Llámanos al {site.phones.office.display} y te contamos qué tenemos
              disponible.
            </p>
          )
        )
      }
    </div>
  </section>

  <!-- 3. Quiénes somos, en datos verificables -->
  <section class="section section--paper about" aria-labelledby="barrio">
    <div class="container about__grid">
      <div class="about__text" data-motion="up">
        <p class="label">Dónde estamos</p>
        <h2 id="barrio" class="about__title">
          Una oficina a pie de calle en <em>Moratalaz</em>, abierta desde {site.foundingYear}.
        </h2>
      </div>
      <div class="about__aside" data-motion="up">
        <p>
          Nos encontrarás en {site.address.street} ({site.address.note.charAt(0).toLowerCase() + site.address.note.slice(1)}), en el barrio en el que nos
          especializamos. Atendemos también inmuebles fuera de Moratalaz.
        </p>
        {
          places.length > 0 && (
            <p class="about__places">
              <span class="about__places-label">Con inmuebles publicados hoy en</span>
              {places.join(' · ')}
            </p>
          )
        }
        <a class="link-arrow" href="/sobre-aljumar/">Conoce Aljumar</a>
      </div>
      <dl class="facts">
        <div data-motion="up">
          <dt>Desde</dt>
          <dd>{site.foundingYear}</dd>
        </div>
        <div data-motion="up">
          <dt>Años de oficio</dt>
          <dd>{years}</dd>
        </div>
        <div data-motion="up">
          <dt>Inmuebles en cartera hoy</dt>
          <dd>{total}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 4. Propietarios -->
  <section class="section section--navy owners on-dark" aria-labelledby="propietarios">
    <div class="container owners__grid">
      <div class="owners__intro" data-motion="up">
        <p class="label">Propietarios</p>
        <h2 id="propietarios">¿Vendes o alquilas tu vivienda? <em>Empieza por saber cuánto vale.</em></h2>
        <p class="lead">Te damos una valoración sin compromiso y, si decides seguir, nos ocupamos del resto.</p>
        <div class="owners__actions">
          <a class="btn btn--accent" href="/vender-mi-vivienda/#formulario">Solicitar valoración</a>
          <a class="link-arrow" href="/vender-mi-vivienda/">Cómo trabajamos</a>
        </div>
      </div>
      <ol class="method">
        {
          method.map((m, i) => (
            <li data-motion="up">
              <span class="method__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. Equipo -->
  {
    team.length > 0 && (
      <section class="section team" aria-labelledby="equipo">
        <div class="container team__grid">
          <div data-motion="up">
            <p class="label">Equipo</p>
            <h2 id="equipo">
              Te atiende <em>una persona</em>, no una centralita.
            </h2>
            <a class="link-arrow" href="/sobre-aljumar/#equipo">
              Sobre nosotros
            </a>
          </div>
          <ul class="team__list">
            {team.map((m) => (
              <li data-motion="up">
                <span class="team__name">{m.name}</span>
                {m.role && <span class="team__role">{m.role}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 6. Consejos -->
  {
    leadPost && (
      <section class="section section--paper journal" aria-labelledby="consejos">
        <div class="container">
          <div class="head">
            <div>
              <p class="label">Consejos inmobiliarios</p>
              <h2 id="consejos">
                Antes de comprar o vender, <em>infórmate</em>
              </h2>
            </div>
            <p class="head__links">
              <a class="link-arrow" href="/consejos-inmobiliarios/">Todos los artículos</a>
            </p>
          </div>
          <div class="journal__grid">
            <article class="journal__lead" data-motion="up">
              <p class="journal__meta">
                {topics[leadPost.data.topic].label} · <time datetime={leadPost.data.pubDate.toISOString().slice(0, 10)}>{date(leadPost.data.pubDate)}</time>
              </p>
              <h3>
                <a href={`/${leadPost.id}/`}>{leadPost.data.title}</a>
              </h3>
              <p>{leadPost.data.description}</p>
            </article>
            <ul class="journal__list">
              {morePosts.map((post) => (
                <li data-motion="up">
                  <article>
                    <p class="journal__meta">
                      {topics[post.data.topic].label} · <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date(post.data.pubDate)}</time>
                    </p>
                    <h3>
                      <a href={`/${post.id}/`}>{post.data.title}</a>
                    </h3>
                  </article>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- 1. Portada ---------- */
  .hero {
    padding-block: var(--s-6) var(--s-8);
    background: var(--paper);
  }
  .hero__grid {
    display: grid;
    gap: var(--s-6);
  }
  .hero__title {
    max-width: 14ch;
    margin-bottom: var(--s-5);
    font-size: var(--fs-3xl);
  }
  .hero .lead {
    max-width: 44ch;
    margin: 0;
  }
  .hero__figure {
    margin: 0 calc(-1 * var(--gutter));
  }
  .hero__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--navy-800) url('/brand/logo-simbolo.png') center / 52px auto no-repeat;
  }
  .hero__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__photo img[data-broken] {
    display: none;
  }
  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-3) var(--gutter) 0;
    font-size: var(--fs-sm);
  }
  .hero__caption-label {
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .hero__caption-link {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
    color: var(--ink);
    text-decoration: none;
  }
  .hero__caption-link strong {
    font-weight: 650;
    color: var(--navy-900);
    font-variant-numeric: lining-nums;
  }
  .hero__caption-link:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--s-8) var(--s-9);
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      column-gap: var(--s-5);
      row-gap: 0;
    }
    .hero__copy {
      grid-column: 1 / 7;
      grid-row: 1;
      align-self: center;
      padding-block: var(--s-6) var(--s-8);
    }
    .hero__figure {
      grid-column: 7 / 13;
      grid-row: 1 / 3;
      margin: 0;
    }
    .hero__photo {
      aspect-ratio: 4 / 5;
      max-height: calc(100vh - var(--header-h) - 6rem);
      min-height: 520px;
      width: 100%;
    }
    .hero__caption {
      padding-inline: 0;
    }
    /* El buscador se superpone al borde de la foto: une las dos columnas. */
    .hero__search {
      position: relative;
      z-index: 2;
      grid-column: 1 / 10;
      grid-row: 2;
      align-self: end;
      margin-bottom: var(--s-8);
    }
    .hero--nophoto .hero__copy,
    .hero--nophoto .hero__search {
      grid-column: 1 / -1;
    }
    .hero__title {
      font-size: clamp(3rem, 1.2rem + 3.6vw, 5rem);
    }
  }

  /* ---------- Cabecera de sección ---------- */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
    margin-bottom: var(--s-7);
  }
  .head h2 {
    margin: 0;
  }
  .head__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin: 0;
  }

  /* ---------- 2. Cartera ---------- */
  .featured__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 340px);
    gap: var(--s-5);
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter) var(--s-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    list-style: none;
    scrollbar-width: thin;
  }
  .featured__item {
    scroll-snap-align: start;
  }
  @media (min-width: 1024px) {
    .featured__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--s-7) var(--s-5);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .featured__item {
      grid-column: span 3;
    }
    .featured__item--lead {
      grid-column: 1 / 7;
      grid-row: span 2;
    }
    .featured__item--lead :global(.pcard__media) {
      flex: 1;
      aspect-ratio: auto;
      min-height: 380px;
    }
    .featured__item--lead :global(.pcard__price) {
      font-size: var(--fs-xl);
    }
    .featured__item--lead :global(.pcard__title) {
      font-size: var(--fs-md);
    }
    /* Con pocos inmuebles, la rejilla no deja huecos. */
    .featured__item--lead:only-child {
      grid-column: 1 / 9;
    }
  }

  /* ---------- 3. Dónde estamos ---------- */
  .about__grid {
    display: grid;
    gap: var(--s-6);
  }
  .about__title {
    margin: 0;
    font-size: var(--fs-2xl);
    max-width: 18ch;
  }
  .about__aside {
    max-width: 46ch;
    color: var(--ink-2);
  }
  .about__places {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
    color: var(--navy-900);
    font-weight: 550;
  }
  .about__places-label {
    display: block;
    margin-bottom: var(--s-1);
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--s-6) 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-3) 0 0;
  }
  .facts div + div {
    padding-left: var(--s-4);
    border-left: 1px solid var(--line-strong);
  }
  .facts dt {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.35;
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4.8rem);
    font-weight: 330;
    font-variation-settings: 'opsz' 144;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--navy-900);
  }
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--s-5);
      row-gap: var(--s-8);
    }
    .about__text {
      grid-column: 1 / 8;
    }
    .about__aside {
      grid-column: 9 / 13;
      align-self: end;
    }
    .facts {
      grid-column: 1 / -1;
      margin: 0;
    }
    .facts div + div {
      padding-left: var(--s-5);
    }
  }

  /* ---------- 4. Propietarios ---------- */
  .owners__grid {
    display: grid;
    gap: var(--s-8);
  }
  .owners h2 {
    font-size: var(--fs-2xl);
    max-width: 17ch;
  }
  .owners h2 em {
    color: var(--lime-500);
  }
  .owners__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-6);
  }
  .method {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .method li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    column-gap: var(--s-4);
    padding-block: var(--s-5);
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }
  .method__n {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 330;
    font-style: italic;
    font-variant-numeric: lining-nums;
    line-height: 1;
    color: var(--lime-500);
  }
  .method h3 {
    margin: 0 0 var(--s-1);
    font-size: var(--fs-md);
    color: var(--white);
  }
  .method p {
    margin: 0;
    color: var(--navy-200);
    font-size: var(--fs-sm);
    max-width: 48ch;
  }
  @media (min-width: 1024px) {
    .owners__grid {
      grid-template-columns: 5fr 1fr 6fr;
    }
    .method {
      grid-column: 3;
    }
    .owners__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }

  /* ---------- 5. Equipo ---------- */
  .team__grid {
    display: grid;
    gap: var(--s-6);
  }
  .team h2 {
    font-size: var(--fs-2xl);
    max-width: 14ch;
  }
  .team__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .team__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line-strong);
  }
  .team__name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 380;
    font-variation-settings: 'opsz' 72;
    color: var(--navy-900);
  }
  .team__role {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  @media (min-width: 1024px) {
    .team__grid {
      grid-template-columns: 5fr 1fr 6fr;
    }
    .team__list {
      grid-column: 3;
    }
  }

  /* ---------- 6. Consejos ---------- */
  .journal__grid {
    display: grid;
    gap: var(--s-6);
  }
  .journal__meta {
    margin: 0 0 var(--s-2);
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .journal h3 a {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 500ms var(--ease-out);
  }
  .journal h3 a:hover,
  .journal h3 a:focus-visible {
    background-size: 100% 1px;
  }
  .journal__lead h3 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 380;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.02em;
    line-height: 1.12;
    max-width: 22ch;
  }
  .journal__lead p:last-child {
    margin: 0;
    max-width: 52ch;
    color: var(--ink-2);
  }
  .journal__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .journal__list li {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line-strong);
  }
  .journal__list h3 {
    margin: 0;
    font-size: var(--fs-base);
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .journal__grid {
      grid-template-columns: 6fr 1fr 5fr;
    }
    .journal__list {
      grid-column: 3;
    }
    .journal__lead {
      padding-top: var(--s-4);
      border-top: 1px solid var(--line-strong);
    }
  }
</style>
