---
import type { GetStaticPaths, PaginateFunction } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import TopicNav from '../../components/TopicNav.astro';

export const getStaticPaths = (async ({ paginate }: { paginate: PaginateFunction }) => {
  const posts = (await getCollection('blog', (e) => !e.data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: { data: CollectionEntry<'blog'>[]; currentPage: number; lastPage: number; url: { prev?: string; next?: string } } };
const first = page.currentPage === 1;
---

<Base
  title={first ? 'Consejos inmobiliarios para comprar, vender y alquilar' : `Consejos inmobiliarios — página ${page.currentPage}`}
  description={first ? 'Guías y consejos de Aljumar Inmuebles sobre compraventa, alquiler, hipotecas, normativa y reformas del hogar, explicados con claridad.' : `Página ${page.currentPage} de ${page.lastPage} de los consejos inmobiliarios de Aljumar: compraventa, alquiler, hipotecas, normativa y hogar.`}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Consejos inmobiliarios', href: '/consejos-inmobiliarios/' },
  ]}
>
  <section class="page-head">
    <div class="container">
      <p class="label" data-hero style="--i:0">Consejos inmobiliarios</p>
      <h1 data-hero style="--i:1">
        {first ? <>Lo que conviene saber antes de <em>comprar, vender o alquilar</em></> : `Consejos inmobiliarios · página ${page.currentPage}`}
      </h1>
      <TopicNav />
    </div>
  </section>

  <section class="section blog-list">
    <div class="container">
      <ul class="posts">
        {
          page.data.map((post) => (
            <li>
              <PostCard post={post} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
      <Pagination current={page.currentPage} last={page.lastPage} base="/consejos-inmobiliarios/" />
    </div>
  </section>
</Base>
