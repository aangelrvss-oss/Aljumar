---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import TopicNav from '../../../components/TopicNav.astro';
import { topics, type TopicKey } from '../../../data/topics';

export function getStaticPaths() {
  return (Object.keys(topics) as TopicKey[]).map((topic) => ({ params: { topic }, props: { topic } }));
}
const { topic } = Astro.props as { topic: TopicKey };
const posts = (await getCollection('blog', (e) => !e.data.draft && e.data.topic === topic)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const t = topics[topic];
---

<Base
  title={`${t.label} · Consejos inmobiliarios`}
  description={t.intro}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Consejos inmobiliarios', href: '/consejos-inmobiliarios/' },
    { name: t.label, href: `/consejos-inmobiliarios/tema/${topic}/` },
  ]}
>
  <section class="page-head">
    <div class="container">
      <p class="label" data-hero style="--i:0">Consejos inmobiliarios</p>
      <h1 data-hero style="--i:1">{t.label}</h1>
      <p class="lead" data-hero style="--i:2">{t.intro}</p>
      <TopicNav current={topic} />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ul class="posts">
        {
          posts.map((post) => (
            <li>
              <PostCard post={post} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
