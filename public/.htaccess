# Generado por scripts/gen-redirects.ts. NO editar a mano.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /inmueble-no-disponible/index.html
AddDefaultCharset UTF-8
AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://fotos15.apinmo.com https://fotos15.inmovilla.com https://*.githubusercontent.com; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  <FilesMatch "\.(css|js|woff2|avif|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

RewriteEngine On

# --- HTTPS (descomentar si el alojamiento no lo fuerza ya; probar antes) ---
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://aljumar.es%{REQUEST_URI} [L,R=301]
# --- www → sin www (la web antigua usa aljumar.es sin www) ---
# RewriteCond %{HTTP_HOST} ^www\.aljumar\.es$ [NC]
# RewriteRule ^ https://aljumar.es%{REQUEST_URI} [L,R=301]

# --- Fichas antiguas del plugin irdinmo: /inmueble/?<código> → nueva ficha ---
RewriteCond %{QUERY_STRING} (^|&)[a-z_]*=(30312733)(&|$) [NC]
RewriteRule ^inmueble/?$ /inmueble/piso-venta-madrid-30312733/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)[a-z_]*=(30233535)(&|$) [NC]
RewriteRule ^inmueble/?$ /inmueble/chalet-venta-rivas-vaciamadrid-30233535/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)[a-z_]*=(29821198)(&|$) [NC]
RewriteRule ^inmueble/?$ /inmueble/piso-venta-madrid-vinateros-29821198/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)[a-z_]*=(29792167)(&|$) [NC]
RewriteRule ^inmueble/?$ /inmueble/piso-venta-madrid-29792167/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)[a-z_]*=(29670372)(&|$) [NC]
RewriteRule ^inmueble/?$ /inmueble/atico-venta-madrid-29670372/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)[a-z_]*=(29301614)(&|$) [NC]
RewriteRule ^inmueble/?$ /inmueble/chalet-venta-sesena-29301614/? [R=301,L]

# --- Inmuebles retirados (vendidos, alquilados o dados de baja): 410 Gone ---

# --- Redirecciones permanentes de la web antigua (docs/migration/redirect-map.csv) ---
RewriteRule ^quieres-vender/?$ /vender-mi-vivienda/? [R=301,L]
